# ─────────────────────────────────────────────────────
#  CONDO-SAFE24 — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores
#  NUNCA suba o .env para o GitHub
# ─────────────────────────────────────────────────────

# Chave secreta do Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sua-chave-secreta-aqui-minimo-32-caracteres

# Senhas de acesso ao sistema
CENTRAL_PASSWORD=senha-forte-para-central
ADMIN_PASSWORD=senha-forte-para-admin

# Fuso horário
APP_TZ=America/Sao_Paulo

# Ambiente (production | development)
FLASK_ENV=production

# Habilitar debug APENAS em desenvolvimento (nunca em produção)
FLASK_DEBUG=false

# Chaves dos clientes (opcional — alternativa ao arquivo data/keys.json)
# CONDO_KEYS_JSON={"CONDO-ABC123":{"name":"Residencial Alfa","active":true}}

# Caminho do arquivo de chaves (padrão: data/keys.json)
# CONDO_KEYS_FILE=data/keys.json

# Porta (Render define automaticamente)
# PORT=10000

# ─────────────────────────────────────────────────────
#  BANCO DE DADOS SQLite
# ─────────────────────────────────────────────────────
# Código para revelar identidade no vault (admin) — OBRIGATÓRIO em produção
# Gere com: python -c "import secrets; print(secrets.token_hex(16))"
REVEAL_SECRET=codigo-secreto-forte-aqui

# Chave AES-256 para cifrar dados pessoais no vault — OBRIGATÓRIO em produção
# Sem isso, os dados são ilegíveis após restart do servidor!
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
VAULT_ENCRYPTION_KEY=sua-chave-hex-64-chars-aqui

# Salt para pseudonimização de IPs (SHA-256 + salt)
IP_HASH_SALT=salt-unico-do-seu-sistema-aqui

# Caminho do banco (padrão: data/condosafe.db)
# CONDO_DB_PATH=data/condosafe.db

# ─────────────────────────────────────────────────────
#  Z-API WHATSAPP (opcional — alertas automáticos)
#  Configure para receber notificação WhatsApp a cada alerta
# ─────────────────────────────────────────────────────
# ZAPI_INSTANCE=SUA_INSTANCIA_ZAPI
# ZAPI_TOKEN=SEU_TOKEN_ZAPI
# ZAPI_PHONE=5561993962090
